# Copy to backend/.env and fill in. Never commit .env.
TRADE1_ENV=development
TRADE1_DATABASE_URL=postgresql+psycopg://trade1:CHANGE_ME@localhost:5432/trade1
# Long random string; the UI/API client sends it as "Authorization: Bearer <token>"
TRADE1_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
TRADE1_LOG_LEVEL=INFO

# BACKTEST (default) | RESEARCH | PAPER | DEMO. There is no LIVE mode.
# DEMO only allows enabling demo trading; it still requires a PASSED validation,
# a verified DEMO account and an explicit confirmation on the dashboard.
TRADE1_EXECUTION_MODE=BACKTEST

# Demo execution limits (engineering defaults for testing, not proven optimal values)
TRADE1_DEMO_RISK_PER_TRADE_PCT=0.25
TRADE1_DEMO_MAX_DAILY_LOSS_PCT=1.0
TRADE1_DEMO_MAX_DRAWDOWN_PCT=10
TRADE1_DEMO_MAX_OPEN_POSITIONS=3
TRADE1_DEMO_MAX_SPREAD_MULTIPLE=3
TRADE1_DEMO_MAX_SLIPPAGE_POINTS=30

# Optional Telegram alerts: create a bot with @BotFather, send it a message,
# then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TRADE1_TELEGRAM_BOT_TOKEN=
TRADE1_TELEGRAM_CHAT_ID=

# MT5 terminal. Leave login/password/server empty to use the account
# already logged in to the terminal (recommended).
TRADE1_MT5_PATH=
TRADE1_MT5_LOGIN=
TRADE1_MT5_PASSWORD=
TRADE1_MT5_SERVER=
# Broker server clock offset from UTC; confirm with `python -m app.cli mt5-check`
TRADE1_MT5_SERVER_UTC_OFFSET_HOURS=0

# Optional economic-calendar feed (Forex Factory weekly export). Empty = disabled.
# Copy the JSON export link from the Forex Factory calendar page, then run
# `python -m app.cli news-check` to confirm the format before relying on it.
TRADE1_NEWS_FEED_URL=
TRADE1_NEWS_BLACKOUT_BEFORE_MIN=30
TRADE1_NEWS_BLACKOUT_AFTER_MIN=30
